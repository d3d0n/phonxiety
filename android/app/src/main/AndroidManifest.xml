<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Signature|privileged permissions granted by the root module's privapp
         allowlist (see android/magisk).  The link/audio permissions live in
         :core:device's manifest next to the code that uses them. -->
    <uses-permission
        android:name="android.permission.REBOOT"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.INSTALL_SELF_UPDATES"
        tools:ignore="ProtectedPermissions" />

    <!-- The wizard offers the battery-optimisation exemption before pairing, because a
         heartbeat miss with the screen off is what kills the link. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <application
        android:name=".PhonxietyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">

        <!-- Macrobenchmark and the baseline-profile generator profile this
             process through the shell; the release build is not debuggable. -->
        <profileable android:shell="true" />

        <!--
            The whole control surface: Compose, Navigation 3, the setup wizard and the dashboard.
            The bridge components themselves are declared by :core:device and merged from its
            library manifest.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Phonxiety.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="pair"
                    android:scheme="phonxiety" />
            </intent-filter>
        </activity>

        <!--
            Setup resumes on the first launch after the reboot the wizard asked for; the
            receiver only posts the reminder, never starts an activity from the broadcast.
        -->
        <receiver
            android:name=".SetupResumeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            The Hang up button on the live-call card. The notification builds an explicit intent for
            this class, so it stays unexported and needs no filter: nothing else can invoke it.
        -->
        <receiver
            android:name=".NotificationActions"
            android:exported="false" />

        <!-- Recordings and transcripts are shared from the app cache, never from app storage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
