<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Signature|privileged permissions granted by the root module's privapp
         allowlist (see android/magisk).  The link/audio permissions live in
         :core:device's manifest next to the code that uses them. -->
    <uses-permission
        android:name="android.permission.REBOOT"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.INSTALL_SELF_UPDATES"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".PhonxietyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">

        <!--
            Companion UI: pairing (QR scan or phonxiety://pair link), link
            status and permission repair.  The bridge components themselves are
            declared by :core:device and merged from its library manifest.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Phonxiety">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="pair"
                    android:scheme="phonxiety" />
            </intent-filter>
        </activity>
    </application>

</manifest>
