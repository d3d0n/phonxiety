<?xml version="1.0" encoding="utf-8"?>
<!-- The brand arrow for the launch screen, on Void in Signal. The kit draws it in a 140-unit
     box; the platform masks the launch icon with a circle two-thirds of that box, so the same
     two strokes are centred and scaled to half inside that safe circle: every point of the
     stroke stays within 70 ± 46.67 units of the centre, with the butt caps and the miter join
     included. It is still one arrow shared with the in-app mark, not a second drawing. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="140"
    android:viewportHeight="140">
    <path
        android:pathData="M44.5,95.5 L95.5,44.5"
        android:strokeColor="#FFFF4FD8"
        android:strokeWidth="12"
        android:strokeLineCap="butt" />
    <path
        android:pathData="M58.5,44.5 H95.5 V81.5"
        android:strokeColor="#FFFF4FD8"
        android:strokeWidth="12"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter" />
</vector>
