    <!-- Reboot. -->
    <string name="onboarding_reboot_metamodule_title">The metamodule activates on the next boot.</string>
    <string name="onboarding_reboot_module_title">One reboot, and the module is active.</string>
    <string name="onboarding_reboot_metamodule_body">Phonxiety is installed after the overlay is mounted, so this boot comes first. After the reboot, open Phonxiety; setup continues where it stopped.</string>
    <string name="onboarding_reboot_module_body">The privileged grants and the system app appear only after the reboot. After the reboot, open Phonxiety; setup continues where it stopped.</string>
