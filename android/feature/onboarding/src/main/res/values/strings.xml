    <!-- Checking. -->
    <string name="onboarding_checking_body">Reading root access, the module and the permissions.</string>

    <!-- No root: the manager guides. -->
    <string name="onboarding_no_root_body">This phone does not have root. Phonxiety still runs and shows diagnostics; installing the module needs one of these root managers.</string>
    <string name="onboarding_guide_magisk">Open the Magisk install guide</string>
    <string name="onboarding_guide_kernelsu">Open the KernelSU install guide</string>
    <string name="onboarding_guide_kernelsu_next">Open the KernelSU-Next guide</string>
    <string name="onboarding_guide_apatch">Open the APatch install guide</string>

    <!-- Root granted but the manager is waiting for a grant. -->
    <string name="onboarding_grant_title">Grant root in %1$s</string>
    <string name="onboarding_grant_title_any">Grant root access</string>
    <string name="onboarding_grant_any_manager">Open the root manager\'s Superuser list, grant Phonxiety, then come back.</string>
    <string name="onboarding_grant_line">%1$s: %2$s</string>
    <string name="onboarding_grant_resume_note">The check runs again when you come back. Once root works, setup continues.</string>
    <string name="onboarding_grant_magisk">Open Magisk, tap Superuser, tap +, then choose Phonxiety and enable it. Magisk adds the grant itself; there is no prompt to answer.</string>
    <string name="onboarding_grant_kernelsu">Open KernelSU, tap Superuser, then open Phonxiety and turn on the Superuser switch. If Phonxiety is missing, force-close the manager and open it again: it caches its app list.</string>
    <string name="onboarding_grant_kernelsu_next">Open KernelSU-Next, tap Superuser, then open Phonxiety and turn on the Superuser switch. If Phonxiety is missing, force-close the manager and open it again: it caches its app list.</string>
    <string name="onboarding_grant_apatch">Open APatch, tap Superuser, then open Phonxiety and allow it. If Phonxiety is missing, force-close the manager and open it again: it caches its app list.</string>

    <!-- Provider needs the metamodule first. -->
    <string name="onboarding_prep_body">%1$s loads modules through a metamodule: a small overlay that mounts system files at boot. Without it, the Phonxiety module installs but never takes effect.</string>
    <string name="onboarding_prep_install">Install it here. The phone downloads meta-overlayfs %1$s, checks its SHA-256 and installs it. It activates on the next boot; Phonxiety installs after that boot.</string>

    <!-- Ready to install / update. -->
