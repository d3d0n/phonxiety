#!/usr/bin/env bash
#MISE description="Pair the USB-connected phone with this daemon without the camera (needs root)"
#
# Grants the app's runtime permissions, writes the link configuration into the
# app's device-protected storage (readable before the first unlock after a
# reboot) and restarts the bridge service. After this the phone reaches the
# daemon over the network; the cable is no longer needed.
#
# The phone credential goes through a private temporary file and a root shell
# stdin. It is never printed and never passed as a command-line argument.
#
# The whole app process is force-stopped and its exit confirmed before the
# file is replaced, so no in-process writer survives the swap.  An empty
# `pidof` proves the previous writers are gone; it is not a lock against a
# later explicit launch (a person or another tool starting the app), so the
# replacement stays as short as possible.
#
# Once the app has been stopped, the previous service is restored only on the
# root script's own report that it aborted before the rename
# (`PX_ABORTED_BEFORE_MV`) together with a re-read of config.json that still
# holds the old bytes.  Magisk runs the root command in a separately forked
# daemon, and adbd signals only its immediate child, so a dropped connection
# proves nothing and the writer may still complete; everything else is
# reported as unknown and the app stays stopped.
#
# Exit codes:
#   0  the configuration was replaced, verified and the service is up;
#   1  nothing changed: refused or interrupted before the root writer was sent (a stopped
#      service is restored), or the old configuration was restored on positive evidence;
#   2  unknown or replaced but unverified: the app stays stopped;
#   3  the configuration was replaced and verified but the service or the
#      link to the daemon did not come up.
#
# PAIR_SERVICE_POLL_TRIES and PAIR_LINK_POLL_TRIES shorten the two waits for
# tests; their defaults are 40 and 30.
set -euo pipefail

ROOT="${MISE_PROJECT_ROOT:?run this task through mise: mise run phone:pair}"
PACKAGE="com.phonxiety.bridge"
REMOTE_CONFIG="/data/user_de/0/$PACKAGE/files/config.json"
ADB="${ADB:-adb}"
SERIAL=""
MODE=()
TMP=""
SERVICE_WAS_RUNNING=0

usage() {
    cat <<'EOF'
Usage: mise run phone:pair [--serial SERIAL] [--lan | --tailscale | --host HOST]

  --serial SERIAL   adb device serial
  --lan             pair by this computer's local network address
  --tailscale       pair by this computer's Tailscale address
  --host HOST       pair by this address or name

Without an address option the phone is paired with the daemon's iroh endpoint
id: it finds this computer on any network without a VPN app. That needs the
running daemon (mise run daemon).

This restarts the bridge service. Do not run it during a call.
EOF
}

die() { printf 'error: %s\n' "$1" >&2; exit 1; }
die_unknown() { printf 'error: %s\n' "$1" >&2; exit 2; }
die_service() { printf 'error: %s\n' "$1" >&2; exit 3; }
note() { printf '%s\n' "$1"; }

cleanup() { if [ -n "$TMP" ]; then rm -rf "$TMP"; fi; }
trap cleanup EXIT

# Before the stop nothing has changed, so an interrupt is a plain refusal.
interrupt_before_stop() {
    printf 'error: interrupted before the app was stopped; the configuration was not touched\n' >&2
    exit 1
}
trap interrupt_before_stop INT TERM HUP

# Before the stop nothing has changed either: a step that fails without its own message
# still ends the run with 1, never with whatever status the failing tool returned.
preparation_failed() {
    printf 'error: a preparation step failed (status %s); the app was not touched\n' "$1" >&2
    exit 1
}
trap 'preparation_failed $?' ERR

while [ $# -gt 0 ]; do
    case "$1" in
        --serial)
            [ $# -ge 2 ] || die "--serial requires a value"
            SERIAL="$2"; shift 2 ;;
        --host)
            [ $# -ge 2 ] || die "--host requires a value"
            MODE=(--host "$2"); shift 2 ;;
        --lan|--tailscale)
            MODE=("$1"); shift ;;
        -h|--help)
            usage; exit 0 ;;
        *)
            die "unknown argument: $1" ;;
    esac
done

command -v "$ADB" >/dev/null 2>&1 || die "adb not found"

ADB_CMD=("$ADB")
if [ -n "$SERIAL" ]; then
    ADB_CMD+=(-s "$SERIAL")
fi

STATE="$("${ADB_CMD[@]}" get-state 2>/dev/null || true)"
[ "$STATE" = "device" ] || die "adb device not ready (state: ${STATE:-offline})"

APK_PATH="$("${ADB_CMD[@]}" shell pm path "$PACKAGE" 2>/dev/null \
    | sed -n 's/^package://p' | head -n1 | tr -d '\r')"
[ -n "$APK_PATH" ] || die "$PACKAGE is not installed; run: mise run phone:install --reboot"

PKG_DUMP="$("${ADB_CMD[@]}" shell dumpsys package "$PACKAGE")"
for perm in CAPTURE_AUDIO_OUTPUT MODIFY_PHONE_STATE CONTROL_INCALL_EXPERIENCE; do
    if ! printf '%s\n' "$PKG_DUMP" | grep -q "$perm.*granted=true"; then
        die "privileged permission $perm is not granted; install the module and reboot: mise run phone:install --reboot"
    fi
done

for perm in RECORD_AUDIO CALL_PHONE READ_PHONE_STATE POST_NOTIFICATIONS ACCESS_LOCAL_NETWORK; do
    "${ADB_CMD[@]}" shell pm grant --user 0 "$PACKAGE" "android.permission.$perm" \
        >/dev/null 2>&1 || true
done
PKG_DUMP="$("${ADB_CMD[@]}" shell dumpsys package "$PACKAGE")"
for perm in RECORD_AUDIO CALL_PHONE READ_PHONE_STATE; do
    if ! printf '%s\n' "$PKG_DUMP" | grep -q "$perm.*granted=true"; then
        die "runtime permission $perm was not granted; inspect: adb shell dumpsys package $PACKAGE"
    fi
done

# ACCESS_LOCAL_NETWORK is a runtime permission from Android 17 only. Without it the phone cannot
# answer the daemon's LAN probes and the iroh handshake falls back to the relay or times out, so a
# silent miss here is checked on the releases that enforce it.
SDK="$("${ADB_CMD[@]}" shell getprop ro.build.version.sdk | tr -d '\r')"
case "$SDK" in '' | *[!0-9]*) SDK=0 ;; esac
if [ "$SDK" -ge 37 ] && ! printf '%s\n' "$PKG_DUMP" | grep -q "ACCESS_LOCAL_NETWORK.*granted=true"; then
    die "runtime permission ACCESS_LOCAL_NETWORK was not granted; grant it in Settings > Apps > Phonxiety > Permissions, then rerun"
fi

TMP="$(mktemp -d "${TMPDIR:-/tmp}/phonxiety-pair.XXXXXX")"
umask 077

uv run --project "$ROOT" phonxiety pair --json ${MODE[@]+"${MODE[@]}"} > "$TMP/config.json" \
    || die "could not build the phone configuration"
[ -s "$TMP/config.json" ] || die "the phone configuration is empty"

# Root is preflighted before anything is stopped: a denied `su` must leave the
# running service untouched.
if ! "${ADB_CMD[@]}" shell su -c id >/dev/null 2>&1; then
    die "root access is not available on the phone"
fi

# What the previous, valid configuration was running as.  The answer is read
# before anything is stopped, so a failed attempt can restore exactly that.
if ! SERVICES="$("${ADB_CMD[@]}" shell dumpsys activity services "$PACKAGE" 2>/dev/null)"; then
    die "could not read the running bridge service; the config was not touched"
fi
if printf '%s\n' "$SERVICES" | grep -q "BridgeService"; then
    SERVICE_WAS_RUNNING=1
fi

restore_service() {
    [ "$SERVICE_WAS_RUNNING" -eq 1 ] || return 0
    note "Restoring the bridge service..."
    if ! "${ADB_CMD[@]}" shell am start-foreground-service --user 0 \
        -n "$PACKAGE/.BridgeService" >/dev/null 2>&1; then
        note "warning: the previously running service could not be restored"
    fi
}

# "" when pidof documents that nothing matches, the pids otherwise, and "error" when
# the query itself failed.  Only the documented no-match status (1) with no output may
# read as "nothing matches"; any other status is a failed query, not an empty answer.
running_pids() {
    local out status pids
    out="$("${ADB_CMD[@]}" shell "pidof $PACKAGE 2>/dev/null; echo PX_STATUS=\$?" 2>/dev/null)" || { printf 'error\n'; return 0; }
    case "$out" in
        *PX_STATUS=*) status="$(printf '%s' "${out##*PX_STATUS=}" | tr -d '\r\n')" ;;
        *) printf 'error\n'; return 0 ;;
    esac
    pids="$(printf '%s' "${out%PX_STATUS=*}" | tr -d '\r' | tr '\n' ' ')"
    pids="${pids# }"
    pids="${pids% }"
    case "$status" in
        0) [ -n "$pids" ] || { printf 'error\n'; return 0; } ;;
        1) [ -z "$pids" ] || { printf 'error\n'; return 0; } ;;
        *) printf 'error\n'; return 0 ;;
    esac
    case "$pids" in
        *[!0-9[:space:]]*) printf 'error\n'; return 0 ;;
    esac
    printf '%s' "$pids"
}

# Prints the config file's hash, "absent" when there is no file, or nothing when the
# query itself failed.  The status travels with the output so a failed query is never
# read as an absent or unchanged file.
phone_config_hash() {
    local out status value
    out="$("${ADB_CMD[@]}" shell "su -c 'if [ -e $REMOTE_CONFIG ]; then sha256sum $REMOTE_CONFIG; else echo PX_ABSENT; fi; echo PX_STATUS=\$?'" 2>/dev/null)" || return 1
    case "$out" in
        *PX_STATUS=*) status="$(printf '%s' "${out##*PX_STATUS=}" | tr -d '\r\n')" ;;
        *) return 1 ;;
    esac
    [ "$status" = "0" ] || return 1
    value="$(printf '%s' "${out%PX_STATUS=*}" | tr -d '\r' | awk 'NF {print $1; exit}')"
    if [ "$value" = "PX_ABSENT" ]; then
        printf 'absent\n'
        return 0
    fi
    [ -n "$value" ] || return 1
    printf '%s\n' "$value"
}

# The previous configuration, read before anything is stopped: the failure path compares
# it with what the phone holds afterwards, and only an unchanged file permits a restore.
OLD_HASH="$(phone_config_hash)" || die "could not read the current phone configuration; the app was not touched"

HASH="$(shasum -a 256 "$TMP/config.json" | awk '{print $1}')"
[ -n "$HASH" ] || die "could not hash the phone configuration"

# The only permitted restore: the remote script itself reported, through its abort path,
# that it stopped before the rename (PX_ABORTED_BEFORE_MV), and the file still holds
# exactly the old bytes.  A root writer may outlive a dropped connection, so a re-read
# alone proves nothing and anything less is unknown.
restore_after_abort() {
    local current
    if ! current="$(phone_config_hash)"; then
        die_unknown "the phone configuration replacement outcome is unknown; a root writer may still complete it; the app stays stopped"
    fi
    if [ "$current" = "$OLD_HASH" ]; then
        restore_service
        die "writing the phone configuration failed; the old configuration is unchanged"
    fi
    die_unknown "the phone configuration replacement outcome is unknown; a root writer may still complete it; the app stays stopped"
}

# The remote script runs as root and never sees the credential on a command
# line: the file is staged next to its destination under a unique private name,
# labelled with the app-data context, then renamed over config.json.  Every
# failure before the rename prints the abort marker the host requires before it
# may restore the old service; a failure after the rename prints no marker.
{
    printf '%s\n' \
        '#!/system/bin/sh' \
        'set -eu' \
        'umask 077' \
        "APP=$PACKAGE" \
        'DATA="/data/user_de/0/$APP"' \
        'DIR="$DATA/files"' \
        'TMPFILE=""' \
        'abort() { echo PX_ABORTED_BEFORE_MV; echo "$1" >&2; exit 1; }' \
        'cleanup() { if [ -n "$TMPFILE" ]; then rm -f "$TMPFILE"; fi; }' \
        'trap cleanup EXIT HUP INT TERM' \
        'label_of() { ls -Zd "$1" 2>/dev/null | awk '"'"'{ for (i = 1; i <= NF; i++) if ($i ~ /^u:object_r:/) { print $i; exit } }'"'"'; }' \
        '[ -d "$DATA" ] || abort "app data directory missing"' \
        'DIR_CREATED=0' \
        'if [ ! -d "$DIR" ]; then' \
        '    mkdir -p "$DIR" || abort "cannot create the app files directory"' \
        '    DIR_CREATED=1' \
        'fi' \
        'DATA_LABEL=$(label_of "$DATA") || abort "cannot read the app-data label"' \
        '[ -n "$DATA_LABEL" ] || abort "cannot read the app-data label"' \
        'if [ "$DIR_CREATED" -eq 1 ]; then' \
        '    chcon "$DATA_LABEL" "$DIR" || abort "cannot label the app files directory"' \
        '    DIR_LABEL=$(label_of "$DIR") || abort "cannot read the app files directory label"' \
        '    [ "$DIR_LABEL" = "$DATA_LABEL" ] || abort "app files directory label mismatch"' \
        'fi' \
        'LABEL=$(label_of "$DIR/config.json") || abort "cannot read the configuration label"' \
        '[ -n "$LABEL" ] || LABEL=$(label_of "$DIR") || abort "cannot read the app files directory label"' \
        '[ -n "$LABEL" ] || abort "cannot read the app-data label"' \
        'TMPFILE="$DIR/.config.json.$$.new"' \
        '[ ! -e "$TMPFILE" ] || abort "temporary file already exists"' \
        "cat > \"\$TMPFILE\" <<'PX_CONFIG_EOF' || abort \"cannot write the temporary file\""
    cat "$TMP/config.json"
    printf '%s\n' \
        'PX_CONFIG_EOF' \
        'UID_=$(stat -c %u "$DATA") || abort "cannot read the app-data owner"' \
        'GID_=$(stat -c %g "$DATA") || abort "cannot read the app-data group"' \
        'chown "$UID_:$GID_" "$DIR" "$TMPFILE" || abort "cannot set ownership"' \
        'chmod 700 "$DIR" || abort "cannot set the app files directory mode"' \
        'chmod 600 "$TMPFILE" || abort "cannot set the temporary file mode"' \
        'chcon "$LABEL" "$TMPFILE" || abort "cannot label the temporary file"' \
        'TMP_LABEL=$(label_of "$TMPFILE") || abort "cannot read the temporary file label"' \
        '[ "$TMP_LABEL" = "$LABEL" ] || abort "temporary file label mismatch"' \
        'mv -f "$TMPFILE" "$DIR/config.json" || abort "cannot replace the configuration file"' \
        'TMPFILE=""' \
        'echo PX_REPLACED=1' \
        'FINAL_LABEL=$(label_of "$DIR/config.json")' \
        '[ "$FINAL_LABEL" = "$LABEL" ] || { echo "final file label mismatch" >&2; exit 1; }' \
        'sha256sum "$DIR/config.json"'
} > "$TMP/setup.sh"

# From here the app may be stopped: errexit is off, every step is checked, and a signal
# is classified like any other failure instead of escaping the decision.  The handler is
# armed before the stop is requested and knows whether the root writer has been sent:
# until it has, the configuration is provably untouched and the service is restored.
trap - ERR
set +e
ABORTED=0
REPLACED_MARK=0
REPLACEMENT_VERIFIED=0
WRITER_SENT=0

# A second interrupt while this decides is ignored: the classification is the answer.
# Before the writer is sent nothing can have changed; after it, a restore needs the
# positive evidence already in hand, and success is never reported.
interrupt_after_stop() {
    trap '' INT TERM HUP
    if [ "$WRITER_SENT" -eq 0 ]; then
        printf 'error: interrupted while the app was being stopped; the configuration was not touched\n' >&2
        restore_service
        exit 1
    fi
    printf 'error: interrupted after the app was stopped\n' >&2
    if [ "$REPLACEMENT_VERIFIED" -eq 1 ]; then
        die_service "the new configuration is in place but the restart was interrupted"
    fi
    if [ "$ABORTED" -eq 1 ]; then
        restore_after_abort
    fi
    die_unknown "the phone configuration replacement outcome is unknown; a root writer may still complete it; the app stays stopped"
}
trap interrupt_after_stop INT TERM HUP

# The whole app process, not only the service: a token write in the app process
# could otherwise outlive the service and race the file swap.  The stop comes after
# every local step that can fail, so nothing below can exit without a decision.
note "Stopping the app process before the config is replaced..."
if ! "${ADB_CMD[@]}" shell am force-stop --user 0 "$PACKAGE" >/dev/null 2>&1; then
    restore_service
    die "could not force-stop the app; the config was not touched"
fi
i=0
PIDS=""
while [ "$i" -lt 20 ]; do
    PIDS="$(running_pids)"
    [ "$PIDS" = "error" ] && break
    [ -z "$PIDS" ] && break
    sleep 0.25 || true
    i=$((i+1))
done
if [ "$PIDS" = "error" ]; then
    restore_service
    die "could not confirm the app process stopped (adb query failed)"
fi
[ -z "$PIDS" ] || { restore_service; die "the app process is still running (pids: $PIDS)"; }

WRITER_SENT=1
REMOTE_OUT="$("${ADB_CMD[@]}" shell "su -c 'sh -s'" < "$TMP/setup.sh" 2>&1)"
REMOTE_STATUS=$?

REMOTE_TEXT="$(printf '%s\n' "$REMOTE_OUT" | tr -d '\r')"
if printf '%s\n' "$REMOTE_TEXT" | grep -qx 'PX_ABORTED_BEFORE_MV'; then
    ABORTED=1
fi
if printf '%s\n' "$REMOTE_TEXT" | grep -qx 'PX_REPLACED=1'; then
    REPLACED_MARK=1
fi

# The root script's own words say why it refused (a label, a missing directory); the
# marker lines carry no credential.
printf '%s\n' "$REMOTE_TEXT" | grep -v -e '^PX_' -e '^$' >&2

if [ "$REPLACED_MARK" -eq 1 ] && [ "$REMOTE_STATUS" -eq 0 ]; then
    REMOTE_HASH="$(printf '%s\n' "$REMOTE_TEXT" | awk 'NF && $0 !~ /^PX_/ {print $1; exit}')"
    [ "$REMOTE_HASH" = "$HASH" ] \
        || die_unknown "phone configuration hash mismatch after replacement; not restarting the bridge"
    REPLACEMENT_VERIFIED=1
elif [ "$REPLACED_MARK" -eq 1 ]; then
    # The rename happened, but the run did not finish cleanly and its hash is not trusted.
    die_unknown "the phone configuration may be replaced but could not be verified; not restarting the bridge"
elif [ "$ABORTED" -eq 1 ]; then
    restore_after_abort
else
    # A transport failure, a missing or unexpected marker, or any other ambiguity: the
    # root writer may still complete the rename, so nothing here permits a restore.
    die_unknown "the phone configuration replacement outcome is unknown; a root writer may still complete it; the app stays stopped"
fi

# An explicit service start clears the stopped state left by force-stop, so the
# restart works without an activity.
note "Starting the bridge service..."
if ! "${ADB_CMD[@]}" shell am start-foreground-service --user 0 \
    -n "$PACKAGE/.BridgeService" >/dev/null 2>&1; then
    die_service "am start-foreground-service failed; the new configuration is in place but the service is not up"
fi

SERVICE_TRIES="${PAIR_SERVICE_POLL_TRIES:-40}"
case "$SERVICE_TRIES" in '' | *[!0-9]*) SERVICE_TRIES=40 ;; esac
i=0
running=0
while [ "$i" -lt "$SERVICE_TRIES" ]; do
    if "${ADB_CMD[@]}" shell dumpsys activity services "$PACKAGE" 2>/dev/null \
        | grep -q "BridgeService"; then
        running=1
        break
    fi
    sleep 0.25 || true
    i=$((i+1))
done
[ "$running" -eq 1 ] \
    || die_service "the bridge service did not stay running; inspect: adb logcat -d -s PhonxietyBridge"

note "Phone paired. Waiting for it to reach the daemon..."
LINK_TRIES="${PAIR_LINK_POLL_TRIES:-30}"
case "$LINK_TRIES" in '' | *[!0-9]*) LINK_TRIES=30 ;; esac
i=0
while [ "$i" -lt "$LINK_TRIES" ]; do
    if uv run --project "$ROOT" phonxiety status --json 2>/dev/null | grep -q '"connected": true'; then
        uv run --project "$ROOT" phonxiety status \
            || die_service "the phone reached the daemon but the status could not be printed"
        exit 0
    fi
    sleep 1 || true
    i=$((i+1))
done
die_service "the phone did not reach the daemon within the wait: check that the daemon is running (mise run daemon) and that the phone has a network connection"
